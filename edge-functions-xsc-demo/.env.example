# Copy to .env (gitignored). Only needed where the program has no secret store
# (sandbox programs); values are embedded in the built package.
XSC_OKTA_CLIENT_SECRET=
XSC_SESSION_SECRET=
# optional: xsc-demo only signs in through its own Okta app (e.g. Adobe corporate Okta)
XSC_DEMO_OKTA_ISSUER=
XSC_DEMO_OKTA_CLIENT_ID=
XSC_DEMO_OKTA_CLIENT_SECRET=
# Dynamic Media secure delivery (OAuth Server-to-Server tech account, AEM admin)
XSC_DM_CLIENT_ID=
XSC_DM_CLIENT_SECRET=
XSC_DM_SCOPE=
# aem.live site authentication token (admin API secrets.json)
XSC_SITE_TOKEN=
